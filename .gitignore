# Your machine's paths, not the project's. Copy config.example.yaml to start.
config.yaml

# Upstream AD stacks (TCP, SimLingo). ~814 MB of other people's repositories,
# each with its own .git. Clone them from upstream and point config.yaml at
# wherever they live -- nothing here is ours to redistribute.
AD software/

__pycache__/
*.pyc

.DS_Store

# --debug output (backends/simlingo.py)
logs/

# benchmark model outputs (large, re-creatable)
benchmark/runs/

# Upstream CoVLM checkout for testing the nav patch, plus the patch repo itself
# (it has its own git repo and GitHub remote).
covlm_test/

# The CoVLM / InterDrive work lives in its own repository now.
covlm/

# Dataset review and rewrite tooling (not needed to run the benchmark)
benchmark/language/rewrite_task/
benchmark/language/review_app.py
benchmark/language/review.py
benchmark/language/apply_review.py
benchmark/language/data/review.csv
benchmark/language/data/model_pass.csv
benchmark/execution/review_app.py
benchmark/execution/data/utterances_review.csv
